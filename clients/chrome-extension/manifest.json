{
  "manifest_version": 3,
  "name": "Cue",
  "version": "0.8.12",
  "minimum_chrome_version": "120",
  "description": "Lets your Cue assistant act inside the browser you're already signed into — via the Chrome DevTools Protocol (CDP) through chrome.debugger.",
  "homepage_url": "https://justcue.ai",
  "permissions": [
    "alarms",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Cue"
  },
  "icons": {
    "16": "icons/production/icon16.png",
    "48": "icons/production/icon48.png",
    "128": "icons/production/icon128.png"
  }
}
