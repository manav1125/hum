# Cue — local Compose secrets. Copy to deploy/.env.cue and fill in.
# deploy/.env.cue is gitignored — never commit real secrets.
# On Render these live in the env groups (cue-shared-tokens / cue-secrets),
# NOT in this file.

# ── Inter-service tokens (generate any strong random string) ─────────────
# On Render these are auto-generated + shared via the cue-shared-tokens group.
# Locally, generate once and reuse the same value across services:
#   openssl rand -hex 32
CES_SERVICE_TOKEN=
ASSISTANT_API_KEY=
GATEWAY_JWT=

# ── Provider (the brain runs on Claude Fable 5) ──────────────────────────
ANTHROPIC_API_KEY=

# ── Optional inbound channels ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Misc ─────────────────────────────────────────────────────────────────
VELLUM_ENVIRONMENT=production
PROXY_ALLOWED_HOSTS=*
DEFAULT_ASSISTANT_ID=cue-local
VELLUM_ASSISTANT_NAME=Cue
CUE_BRAIN_MODEL=claude-fable-5
